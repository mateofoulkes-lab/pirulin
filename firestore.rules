rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function allowedEmail() {
      return signedIn() && request.auth.token.email in [
        'mateofoulkes@gmail.com',
        'danifernandez.sn@gmail.com'
      ];
    }

    function isOwner(uid) {
      return allowedEmail() && request.auth.uid == uid;
    }

    // Private per-user data. The other Pirulín user cannot read it.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Shared Pirulín data. Exactly the two allowed authenticated users.
    match /shared/{document=**} {
      allow read, write: if allowedEmail();
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
